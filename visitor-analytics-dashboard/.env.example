# এই ফাইলটি কপি করে নাম দাও .env
# তারপর নিচের মানগুলো তোমার নিজের তথ্য দিয়ে পূরণ করো

# ডাটাবেস কনফিগারেশন
DB_HOST=localhost
DB_PORT=5432
DB_NAME=visitor_analytics
DB_USER=postgres
DB_PASSWORD=your_password_here

# ipinfo.io API Token (https://ipinfo.io/signup থেকে ফ্রি নিতে পারো)
IPINFO_TOKEN=your_ipinfo_token_here

# development হলে login page এ ডিফল্ট credential এর হিন্ট দেখাবে।
# সাইট লাইভ করার সময় অবশ্যই production করে দাও।
APP_ENV=development
